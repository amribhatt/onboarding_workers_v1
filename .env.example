# Copy to .env (git-ignored). The web console's Settings page can also write these for you.

# openrouter | openai | ollama (local) | compatible (any OpenAI-style service) | vertex (Google Cloud) |
# demo (offline, scripted, no key; only knows the bundled sample)
WORKER_MODEL_PROVIDER=openrouter

# A free OpenRouter model that can call tools. `onboarding-worker models` lists them.
WORKER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OpenRouter tries these in order if the first model errors or is rate limited (comma separated).
WORKER_MODEL_FALLBACKS=google/gemma-4-31b-it:free

OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Local model through Ollama: WORKER_MODEL_PROVIDER=ollama, WORKER_MODEL=<a tool-calling model you have pulled>
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Any OpenAI-style service (LM Studio, vLLM, LiteLLM, a company gateway): WORKER_MODEL_PROVIDER=compatible
# WORKER_BASE_URL=http://host:port/v1
# WORKER_API_KEY=
# Google Cloud (Vertex AI) with a service-account JSON: WORKER_MODEL_PROVIDER=vertex, WORKER_MODEL=<a Gemini model>
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/service-account.json   (the path only; never commit the file)
# GCP_PROJECT=            (defaults to the project in the JSON)
# GCP_LOCATION=us-central1

# Seconds per model request, and retries on transient errors.
# WORKER_TIMEOUT=90
# WORKER_MAX_RETRIES=4

# When set, every state-changing web call (upload, run, approve, settings) needs the header
# X-Approver-Token with this value. Set it whenever the console is reachable by anyone but you.
# WORKER_APPROVER_TOKEN=

# Use a different env file than ./.env
# WORKER_ENV_FILE=

# ---- docker compose (docker-compose.yml) ------------------------------------------------------------------
# Database passwords are NOT here: scripts/init_secrets.py writes them to ./secrets/ (mounted as files).
# WORKER_APPROVER_TOKEN above is required by the compose file.
# Neo4j is a derived view, off by default. To use it: set WORKER_GRAPH=on and NEO4J_PASSWORD, then
# `docker compose --profile graph up -d`.
# WORKER_GRAPH=off
# NEO4J_PASSWORD=
# How long a shutdown waits for work that was already accepted, and how often anchors/verification run (seconds).
# WORKER_DRAIN_SECONDS=45
# WORKER_ANCHOR_INTERVAL_SECONDS=900
# WORKER_VERIFY_INTERVAL_SECONDS=300
# One JSON object per log line (default in the container) or plain text.
# WORKER_LOG_FORMAT=json

# Forgot password: email the one-time reset code. Without WORKER_SMTP_HOST the code is written to the server log.
# WORKER_SMTP_HOST=
# WORKER_SMTP_PORT=587
# WORKER_SMTP_USER=
# WORKER_SMTP_PASSWORD=
# WORKER_SMTP_FROM=onboarding-worker@example.com
